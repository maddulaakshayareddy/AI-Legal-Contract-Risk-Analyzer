# Secrets
.env
.env.*
!.env.example
/backend/.env
/frontend/.env

# Python virtual environments
.venv/
venv/
backend/venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local databases
*.db
*.sqlite
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/

# Frontend dependencies and build output
frontend/node_modules/
frontend/build/
frontend/dist/

# Local editor and OS files
.vscode/
.DS_Store
Thumbs.db

# Uploaded documents and generated reports
backend/uploads/*
backend/reports/*

# Preserve placeholders
!backend/uploads/.gitkeep
!backend/reports/.gitkeep